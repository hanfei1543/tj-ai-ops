# Windows GR Worker 环境配置模板（复制为 .env 后填写真实值；.env 不进 Git、不进 ZIP 凭据）
# 说明：本文件只有占位符，不含任何真实凭据。真实值由你本人填到本机 .env，绝不进聊天/日志/Git。

# Supabase 连接（tj_preview 隔离 schema）
TJ_SUPABASE_URL=
TJ_SUPABASE_ANON_KEY=

# executor 成员的 Supabase Auth 登录（claim/result 的身份；必须是 tj_gr_memberships 里的 executor/admin）
TJ_GR_EXECUTOR_EMAIL=
TJ_GR_EXECUTOR_PASSWORD=

# 本地 GR Queue 根目录（自动创建 Pending/Processing/Done/Failed/NeedsReview）
TJ_GR_QUEUE_DIR=C:\Users\Administrator\Desktop\operation\GR_Queue

# 事件账本（JSONL，追加式；重复阻断按 task_id）
TJ_GR_LEDGER_FILE=C:\Users\Administrator\Desktop\operation\GR_Queue\ledger.jsonl

# 轮询间隔（毫秒，常驻模式）
TJ_GR_POLL_MS=5000

# PAD 适配器是否已接入（true 才会走 claim → saveEntry → readBack 全流程；未接入时 worker 不 claim）
TJ_GR_PAD_CONNECTED=false
